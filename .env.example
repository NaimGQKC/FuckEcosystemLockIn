# ---------------------------------------------------------------------------
# Yen voice agent — environment configuration
#
# Copy to `.env` and fill in. For the $0 web-tested POC you only need the
# LiveKit + provider keys; the reservation backend defaults to the in-process
# mock and needs no credentials.
# ---------------------------------------------------------------------------

# --- LiveKit Cloud (Build tier, free) -------------------------------------
# From the LiveKit Cloud dashboard -> Settings -> Keys.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech-to-text: Deepgram Nova-3 ($200 free credit) -------------------
DEEPGRAM_API_KEY=

# --- LLM ------------------------------------------------------------------
# Pick ONE runtime LLM. Gemini 2.5 Flash-Lite is cheapest; GPT-4o-mini works too.
# Set YEN_LLM_PROVIDER to "google" or "openai".
YEN_LLM_PROVIDER=google
GOOGLE_API_KEY=
OPENAI_API_KEY=

# --- Text-to-speech -------------------------------------------------------
# English MVP: Deepgram Aura-2 (shares the Deepgram key above).
# Bilingual launch: set YEN_TTS_PROVIDER=cartesia and add CARTESIA_API_KEY.
YEN_TTS_PROVIDER=deepgram
CARTESIA_API_KEY=

# --- Language -------------------------------------------------------------
# "en" for the English-first MVP, "multi" to enable FR/EN code-switching
# (Nova-3 Multilingual STT + a multilingual TTS voice).
YEN_LANGUAGE_MODE=en

# --- Reservation backend --------------------------------------------------
# "mock"  -> in-process FastAPI + SQLite Libro mock (default, no creds)
# "mock-http" -> talk to a separately running mock server (YEN_MOCK_BASE_URL)
# "libro" -> the real Libro JSON:API (Phase 3; requires partner credentials)
YEN_RESERVATION_BACKEND=mock
YEN_MOCK_BASE_URL=http://localhost:8000
YEN_MOCK_DB_PATH=mock_libro_data/yen.sqlite

# The restaurant id the agent operates on (matches the seeded mock by default).
YEN_RESTAURANT_ID=rest_yen_mtl

# --- Real Libro (Phase 3 only) --------------------------------------------
LIBRO_BASE_URL=https://api.staging.libro.app
LIBRO_CLIENT_ID=
LIBRO_CLIENT_SECRET=
LIBRO_RESTAURANT_ID=
