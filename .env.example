# ============================================================================
#  YEN VOICE AGENT — copy this file to `.env` and fill in the 5 values below.
#
#      cp .env.example .env
#
#  Then check your setup:   python scripts/check_setup.py
#  Then talk to the agent:  python agent.py console
# ============================================================================


# ----------------------------------------------------------------------------
#  REQUIRED (5 values, 3 free accounts — no credit card needed for any)
# ----------------------------------------------------------------------------

# 1) LiveKit Cloud  →  https://cloud.livekit.io
#    Create a project, then: Settings → API Keys → "Create key".
#    Copy all three values it shows you:
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=PASTE_LIVEKIT_API_KEY_HERE
LIVEKIT_API_SECRET=PASTE_LIVEKIT_API_SECRET_HERE

# 2) Deepgram (speech-to-text AND text-to-speech)  →  https://console.deepgram.com
#    Sign up (free $200 credit), then: API Keys → "Create a New API Key".
DEEPGRAM_API_KEY=PASTE_DEEPGRAM_KEY_HERE

# 3) Google Gemini (the LLM)  →  https://aistudio.google.com/apikey
#    Click "Create API key".
GOOGLE_API_KEY=PASTE_GOOGLE_KEY_HERE


# ----------------------------------------------------------------------------
#  OPTIONAL — sensible defaults, only touch if you want to change behavior
# ----------------------------------------------------------------------------

# Language: "en" = English only (default). "multi" = French + English
# (also switch YEN_TTS_PROVIDER to cartesia below for native French voices).
YEN_LANGUAGE_MODE=en

# LLM provider: "google" (default, Gemini Flash-Lite) or "openai" (GPT-4o-mini).
# If "openai", set OPENAI_API_KEY.
YEN_LLM_PROVIDER=google
OPENAI_API_KEY=

# TTS provider: "deepgram" (default, English) or "cartesia" (French + English).
# If "cartesia", get a key at https://play.cartesia.ai
YEN_TTS_PROVIDER=deepgram
CARTESIA_API_KEY=

# Reservation backend:
#   "mock"          built-in fake Libro (default — no credentials, use for demos)
#   "mock-http"     the mock, but over a running server
#   "libro-private" the REAL YEN reservations via the Libro dashboard API (below)
#   "libro"         the (unused) official partner OAuth API
YEN_RESERVATION_BACKEND=mock
YEN_MOCK_BASE_URL=http://localhost:8000
YEN_MOCK_DB_PATH=:memory:
YEN_RESTAURANT_ID=rest_yen_mtl

# --- REAL Libro via the dashboard (private) API -----------------------------
# Set YEN_RESERVATION_BACKEND=libro-private to book against the live floor.
# The token is a long-lived master credential for the restaurant's reservations
# — treat it EXACTLY like a password: never commit it, never log it, never paste
# it in chat. It lives only here in your local .env (which is git-ignored).
# First run the read-only probe to confirm shapes:
#   python scripts/probe_libro_private.py --date 2026-08-15 --party 2
LIBRO_PRIVATE_BASE_URL=https://api.libroreserve.com
LIBRO_PRIVATE_TOKEN=
LIBRO_PRIVATE_EMAIL=
LIBRO_PRIVATE_RESTAURANT_ID=8169

# --- Official partner OAuth API (not currently used) ------------------------
LIBRO_BASE_URL=https://api.staging.libro.app
LIBRO_CLIENT_ID=
LIBRO_CLIENT_SECRET=
LIBRO_RESTAURANT_ID=
